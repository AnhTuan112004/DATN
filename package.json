{
  "name": "peopleinsight-ai",
  "version": "6.1.0",
  "private": true,
  "description": "PeopleInsight AI - AI-Powered Enterprise Human Resource Management System",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:backend": "npm --prefix backend test",
    "test:payroll": "npm --prefix backend run test:payroll",
    "test:security": "npm --prefix backend run test:security",
    "benchmark:payroll": "node experiments/payroll/benchmark.js",
    "stress:payroll": "node experiments/payroll/stress_test.js",
    "benchmark:ai": "node experiments/ai/benchmark_chatbot_130.js",
    "train:ml": "node experiments/ml/train_and_evaluate.js",
    "test:load": "node experiments/load/run_k6.js",
    "demo:reset": "npm --prefix backend run demo:reset",
    "lint": "eslint backend/src frontend/src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "author": "PeopleInsight Team",
  "license": "UNLICENSED"
}
