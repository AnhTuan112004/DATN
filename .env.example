# ===================================================
# PEOPLEINSIGHT AI (v6.1 FINAL FREEZE) - ENVIRONMENT
# ===================================================

# NODE & SERVER CONFIG
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
APEX_DOMAIN=peopleinsight.vn

# MONGODB ATLAS (M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/peopleinsight?retryWrites=true&w=majority

# JWT SECRETS (Access 15m, Refresh 7d)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_15m_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_7d_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# GOOGLE GEMINI API (Dòng 3.x only)
# Cấu hình 2 keys luân phiên để chống cạn quota
GEMINI_API_KEY_PRIMARY=AIzaSy...
GEMINI_API_KEY_FALLBACK=AIzaSy...
GEMINI_MODEL=gemini-3.0-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# CLOUDINARY (Upload avatar nhân viên)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SECURITY & HMAC SECRETS
QR_HMAC_SECRET=your_qr_code_hmac_secret_sha256_min_32_chars
KIOSK_CHALLENGE_SECRET=your_kiosk_liveness_challenge_secret_32_chars

# CRON JOB SECRET (Để cron-job.org trigger /api/jobs/run)
CRON_JOB_API_KEY=your_cron_job_secret_token
